# Private server configuration. Copy to .env; fill with original IDs from the private handoff.
APP_ORIGIN=http://localhost:3000
PORT=3000
STATE_DIR=.state
OWNER_EMAIL=replace_owner_email
GOOGLE_CLIENT_ID=replace_google_client_id
GOOGLE_CLIENT_SECRET=replace_google_client_secret
TOKEN_ENCRYPTION_KEY=replace_32_byte_base64_key
AUTO_PUBLISH_ENABLED=false
SOURCE_SPREADSHEET_ID=replace_original_source_id
CASH_JOURNAL_SHEET_ID=replace_original_journal_sheet_id
PHBI_SHEET_ID=replace_original_phbi_sheet_id
SYNC_SHEET_ID=replace_original_checkpoint_sheet_id
REPORT_SPREADSHEET_ID=replace_original_report_workbook_id
REPORT_SUMMARY_SHEET_ID=replace_original_summary_sheet_id
REPORT_INCOME_SHEET_ID=replace_original_income_sheet_id
REPORT_EXPENSE_SHEET_ID=replace_original_expense_sheet_id
PUBLIC_PDF_ID=replace_original_public_pdf_id
PRIVATE_PREVIEW_PDF_ID=replace_original_private_preview_pdf_id
ARCHIVE_FOLDER_ID=replace_original_private_archive_folder_id
REPORT_BASELINE=replace_frozen_baseline_json
PHBI_REPORT_BASELINE=replace_frozen_phbi_baseline_json

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{dist/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,public/index.html,node_modules/pdfjs-dist/standard_fonts/**,node_modules/@napi-rs/canvas-linux-x64-gnu/**}"
    }
  },
  "routes": [
    {
      "src": "/.*",
      "dest": "/api/index"
    }
  ]
}
